generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String       @id @default(cuid())
  tenantId    String       @default("default")
  name        String
  description String?
  permissions Permission[]
  users       User[]
  bonusPools  BonusPool[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  @@unique([name, tenantId])
  @@index([tenantId])
}

model Permission {
  id        String  @id @default(cuid())
  roleId    String
  module    String // e.g. "Cashier", "Inventory", "Staff"
  canRead   Boolean @default(false)
  canCreate Boolean @default(false)
  canUpdate Boolean @default(false)
  canDelete Boolean @default(false)
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module])
}

enum RequestStatus {
  Pending
  Approved
  Rejected
}

enum PaymentMethod {
  CASH
  QRIS
  TRANSFER
  E_WALLET
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
  hadir
  terlambat
  izin
  sakit
}

enum StockTransferStatus {
  Pending
  Approved
  Completed
  Rejected
  Cancelled
}

enum PurchaseOrderStatus {
  Draft
  Sent
  Partial
  Received
  Cancelled
}

enum StockOutType {
  InternalUse
  Damaged
  Lost
  Adjustment
}

enum SupplierReturnStatus {
  Draft
  Sent
  Completed
}

enum SupplierReturnReason {
  Defective
  WrongItem
  Overstock
  Other
}

enum StockAuditStatus {
  Open
  InProgress
  Completed
}

enum InventoryUnitStatus {
  Available
  Sold
  Defective
}

enum TransactionSource {
  POS
  SERVICE
}

enum TransactionStatus {
  SUCCESS
  CANCELLED
  PENDING
  Paid
  Unpaid
  Canceled
}

model Branch {
  id              String           @id @default(cuid())
  tenantId        String           @default("default")
  name            String
  address         String
  phone           String
  latitude        Float
  longitude       Float
  radiusMeters    Int              @default(50)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  updatedBy       String?
  serviceTickets  ServiceTicket[]
  shifts          Shift[]
  stocks          Stock[]
  transactions    Transaction[]
  users           User[]
  transfersFrom   StockTransfer[]  @relation("FromBranch")
  transfersTo     StockTransfer[]  @relation("ToBranch")
  units           InventoryUnit[]
  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceipt[]
  stockOuts       StockOut[]
  supplierReturns SupplierReturn[]
  stockAudits     StockAudit[]

  @@index([tenantId])
}

model User {
  id             String          @id @default(cuid())
  tenantId       String          @default("default")
  name           String?
  email          String          @unique
  password       String?
  roleId         String
  role           Role            @relation(fields: [roleId], references: [id])
  createdAt      DateTime        @default(now())
  joinDate       DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  updatedBy      String?
  branchId       String
  wageType       String?         @default("Monthly")
  wageRate       Decimal?        @default(0) @db.Decimal(18, 2)
  allowance      Decimal?        @default(0) @db.Decimal(18, 2)
  insuranceDed   Decimal?        @default(0) @db.Decimal(18, 2)
  shiftId        String?
  baseSalary     Decimal?        @default(0) @db.Decimal(18, 2)
  leaveQuota     Int?            @default(12)
  phone          String?
  address        String?
  incentiveRate  Decimal?        @default(0) @db.Decimal(18, 2)
  incentiveType  String?         @default("None") // Retail, Service, Profit, All, None
  incentiveMode  String?         @default("Percentage") // Percentage or Flat
  cashAdvances   CashAdvance[]
  leaveRequests  LeaveRequest[]
  serviceTickets ServiceTicket[]
  transactions   Transaction[]
  attendances    Attendance[]
  overtimes      Overtime[]
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([tenantId])
}

model Shift {
  id        String    @id @default(cuid())
  tenantId  String    @default("default")
  name      String
  startTime DateTime
  endTime   DateTime
  branchId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  updatedBy String?
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([tenantId])
}

model CashAdvance {
  id         String        @id @default(cuid())
  tenantId   String        @default("default")
  employeeId String
  date       DateTime      @default(now())
  amount     Decimal       @db.Decimal(18, 2)
  reason     String
  status     RequestStatus @default(Pending)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?
  updatedBy  String?
  employee   User          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([date])
  @@index([tenantId])
}

model LeaveRequest {
  id         String        @id @default(cuid())
  tenantId   String        @default("default")
  employeeId String
  startDate  DateTime
  endDate    DateTime
  type       String
  reason     String
  status     RequestStatus @default(Pending)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?
  updatedBy  String?
  employee   User          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([tenantId])
}

model Category {
  id             String          @id @default(cuid())
  tenantId       String          @default("default")
  name           String          @unique
  inventoryItems InventoryItem[]

  @@index([tenantId])
}

model InventoryItem {
  id                  String               @id @default(cuid())
  tenantId            String               @default("default")
  name                String
  sku                 String               @unique
  categoryId          String
  category            Category             @relation(fields: [categoryId], references: [id])
  costPrice           Decimal              @db.Decimal(18, 2)
  basePrice           Decimal              @db.Decimal(18, 2)
  unit                String
  rack                String?
  image               String?
  showInPos           Boolean              @default(true)
  warranty            String? // e.g. "30 Hari", "3 Bulan", "1 Tahun"
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  updatedBy           String?
  serviceSpareparts   ServiceSparepart[]
  stocks              Stock[]
  transactionItems    TransactionItem[]
  transferItems       StockTransferItem[]
  units               InventoryUnit[]
  purchaseOrderItems  PurchaseOrderItem[]
  goodsReceiptItems   GoodsReceiptItem[]
  stockOutItems       StockOutItem[]
  supplierReturnItems SupplierReturnItem[]
  stockAuditItems     StockAuditItem[]

  @@index([categoryId])
  @@index([tenantId])
}

model Stock {
  id          String        @id @default(cuid())
  tenantId    String        @default("default")
  itemId      String
  branchId    String
  quantity    Int           @default(0)
  reservedQty Int           @default(0)
  minStock    Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  deletedAt   DateTime?
  updatedBy   String?
  branch      Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, branchId])
  @@index([branchId])
  @@index([itemId])
  @@index([tenantId])
}

model Transaction {
  id              String            @id @default(cuid())
  tenantId        String            @default("default")
  date            DateTime          @default(now())
  branchId        String
  cashierId       String
  source          TransactionSource
  serviceTicketId String?
  total           Decimal           @db.Decimal(18, 2)
  paymentMethod   PaymentMethod
  amountPaid      Decimal           @db.Decimal(18, 2)
  customerName    String?
  customerPhone   String?
  customerAddress String?
  change          Decimal           @db.Decimal(18, 2)
  tax             Decimal           @db.Decimal(18, 2)
  discount        Decimal           @db.Decimal(18, 2)
  status          TransactionStatus
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  updatedBy       String?
  branch          Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashier         User              @relation(fields: [cashierId], references: [id], onDelete: Cascade)
  items           TransactionItem[]

  @@index([branchId])
  @@index([cashierId])
  @@index([date])
  @@index([tenantId])
}

model TransactionItem {
  id            String         @id @default(cuid())
  tenantId      String         @default("default")
  transactionId String
  itemId        String?
  name          String
  category      String
  price         Decimal        @db.Decimal(18, 2)
  costPrice     Decimal        @db.Decimal(18, 2)
  quantity      Int
  discount      Decimal        @default(0) @db.Decimal(18, 2)
  technicianId  String?
  item          InventoryItem? @relation(fields: [itemId], references: [id])
  transaction   Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([itemId])
  @@index([tenantId])
}

enum ServiceStatus {
  Pending // Masuk — unit baru diterima
  InProgress // Proses — sedang dikerjakan teknisi
  OnHold // Tertunda — menunggu sparepart
  WaitingApproval // Menunggu Kasir — teknisi selesai, kasir isi harga & konfirmasi
  ReadyForPickup // Siap Diambil — selesai dikerjakan, menunggu pengambilan & pembayaran
  Completed // Selesai — sudah diambil pelanggan & lunas
  Returned // Return — dikembalikan pelanggan (klaim garansi)
  Cancelled // Batal — dibatalkan
}

enum ServicePaymentStatus {
  Unpaid
  DP
  Paid
}

model ServiceTicket {
  id              String               @id @default(cuid())
  tenantId        String               @default("default")
  dateOpened      DateTime             @default(now())
  dateClosed      DateTime?
  customerName    String
  customerPhone   String
  customerAddress String?
  deviceModel     String
  deviceSerial    String
  issue           String
  diagnosis       String?
  estimatedCost   Decimal              @db.Decimal(18, 2)
  serviceFee      Decimal              @db.Decimal(18, 2)
  status          ServiceStatus        @default(Pending)
  technicianId    String?
  branchId        String
  incentiveType   String               @default("Percentage") // Percentage or Flat
  incentiveValue  Decimal              @default(0) @db.Decimal(18, 2)
  // Garansi
  warrantyDays    Int                  @default(0)
  warrantyExpiry  DateTime?
  // Pengambilan unit
  pickupCode      String?              @unique
  pickedUpAt      DateTime?
  pickedUpBy      String? // nama penerima
  // Return / klaim garansi
  returnReason    String?
  returnedAt      DateTime?
  returnTxId      String? // ID transaksi koreksi (refund)
  // Checklist teknisi (JSON array)
  preCheckData    Json? // checklist sebelum pengerjaan
  postCheckData   Json? // checklist setelah pengerjaan
  // Pembayaran
  paymentStatus   ServicePaymentStatus @default(Unpaid)
  dpAmount        Decimal?             @db.Decimal(18, 2)
  readyAt         DateTime? // timestamp saat masuk ReadyForPickup
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?
  updatedBy       String?
  spareparts      ServiceSparepart[]
  branch          Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  technician      User?                @relation(fields: [technicianId], references: [id])

  @@index([branchId])
  @@index([technicianId])
  @@index([tenantId])
  @@index([pickupCode])
}

model ServiceSparepart {
  id        String        @id @default(cuid())
  tenantId  String        @default("default")
  ticketId  String
  itemId    String
  quantity  Int
  price     Decimal       @db.Decimal(18, 2)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  updatedBy String?
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  ticket    ServiceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([itemId])
  @@index([tenantId])
}

model Attendance {
  id                  String           @id @default(cuid())
  tenantId            String           @default("default")
  employeeId          String
  employeeName        String
  branchId            String
  date                DateTime
  checkInTime         DateTime
  checkOutTime        DateTime?
  status              AttendanceStatus
  isInRadius          Boolean
  isMockGPS           Boolean
  latitude            Float?
  longitude           Float?
  photoUrl            String?
  checkOutPhotoUrl    String?
  checkOutLatitude    Float?
  checkOutLongitude   Float?
  workDurationMinutes Int?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?
  updatedBy           String?
  employee            User             @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([employeeId])
  @@index([date])
  @@index([tenantId])
}

model StoreProfile {
  id                         String    @id @default("default")
  tenantId                   String    @default("default")
  name                       String    @default("Kasirai POS")
  address                    String    @default("")
  phone                      String    @default("")
  taxPercentage              Float     @default(0)
  enableTax                  Boolean   @default(false)
  serviceIncentivePercentage Float     @default(10)
  startTime                  String    @default("09:00")
  endTime                    String    @default("18:00")
  attendanceRate             Float     @default(0)
  latePenalty                Float     @default(0)
  absentPenalty              Float     @default(0)
  totalWorkDays              Int       @default(26)
  baseSalary                 Decimal   @default(0) @db.Decimal(18, 2)
  overtimeRate               Decimal   @default(0) @db.Decimal(18, 2)
  serviceIncentive           Decimal   @default(10) @db.Decimal(18, 2)
  payDay                     Int       @default(1)
  thrMonth                   Int? // 1-12, month to give THR
  thrMinWorkMonths           Int       @default(12) // requirement to get full THR
  thrMultiplier              Decimal   @default(1.0) @db.Decimal(18, 2)
  updatedAt                  DateTime  @updatedAt
  deletedAt                  DateTime?
  updatedBy                  String?

  @@index([tenantId])
}

model ServiceType {
  id             String                   @id @default(cuid())
  tenantId       String                   @default("default")
  name           String                   @unique
  price          Decimal                  @db.Decimal(18, 2)
  category       String?
  feeType        String                   @default("Flat") // Flat or Percentage
  feeValue       Decimal                  @default(0) @db.Decimal(18, 2)
  incentiveType  String                   @default("Percentage") // Percentage or Flat
  incentiveValue Decimal                  @default(0) @db.Decimal(18, 2)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  deletedAt      DateTime?
  updatedBy      String?
  deviceModels   ServiceTypeDeviceModel[]

  @@index([tenantId])
}

model ServiceTypeDeviceModel {
  id            String      @id @default(cuid())
  serviceTypeId String
  deviceModelId String
  price         Decimal     @default(0) @db.Decimal(18, 2)
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)
  deviceModel   DeviceModel @relation(fields: [deviceModelId], references: [id], onDelete: Cascade)

  @@unique([serviceTypeId, deviceModelId])
  @@index([serviceTypeId])
  @@index([deviceModelId])
}

model Overtime {
  id         String        @id @default(cuid())
  tenantId   String        @default("default")
  employeeId String
  hours      Float         @default(0)
  date       DateTime      @default(now())
  reason     String        @default("")
  status     RequestStatus @default(Pending)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?
  updatedBy  String?
  employee   User          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([date])
  @@index([tenantId])
}

model DeviceModel {
  id           String                   @id @default(cuid())
  tenantId     String                   @default("default")
  name         String                   @unique
  brand        String                   @default("Apple")
  type         String // Smartphone, Laptop, Tablet
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @default(now()) @updatedAt
  serviceTypes ServiceTypeDeviceModel[]

  @@index([tenantId])
}

model StockTransfer {
  id           String              @id @default(cuid())
  tenantId     String              @default("default")
  fromBranchId String
  toBranchId   String
  status       StockTransferStatus @default(Pending)
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?
  updatedBy    String?
  fromBranch   Branch              @relation("FromBranch", fields: [fromBranchId], references: [id], onDelete: Cascade)
  toBranch     Branch              @relation("ToBranch", fields: [toBranchId], references: [id], onDelete: Cascade)
  items        StockTransferItem[]

  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([tenantId])
}

model StockTransferItem {
  id         String        @id @default(cuid())
  tenantId   String        @default("default")
  transferId String
  itemId     String
  quantity   Int
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([itemId])
  @@index([tenantId])
}

model InventoryUnit {
  id           String              @id @default(cuid())
  tenantId     String              @default("default")
  itemId       String
  branchId     String
  serialNumber String?
  status       InventoryUnitStatus @default(Available)
  costPrice    Decimal?            @db.Decimal(18, 2)
  entryDate    DateTime            @default(now())
  soldDate     DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?
  updatedBy    String?
  item         InventoryItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  branch       Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([serialNumber, branchId])
  @@index([branchId])
  @@index([itemId])
  @@index([tenantId])
}

model BonusPool {
  id         String   @id @default(cuid())
  tenantId   String   @default("default")
  name       String
  amount     Decimal  @db.Decimal(18, 2)
  month      Int // 1-12
  year       Int
  roleId     String? // Targeting specific division
  branchId   String? // Targeting specific branch
  employeeId String? // Targeting specific person
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  role       Role?    @relation(fields: [roleId], references: [id])

  @@index([roleId])
  @@index([tenantId])
}

model Supplier {
  id              String           @id @default(cuid())
  tenantId        String           @default("default")
  code            String
  name            String
  phone           String?
  email           String?
  address         String?
  notes           String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  purchaseOrders  PurchaseOrder[]
  supplierReturns SupplierReturn[]

  @@unique([code, tenantId])
  @@index([tenantId])
}

model PurchaseOrder {
  id            String              @id @default(cuid())
  tenantId      String              @default("default")
  poNumber      String
  supplierId    String
  branchId      String
  status        PurchaseOrderStatus @default(Draft)
  orderDate     DateTime            @default(now())
  expectedDate  DateTime?
  notes         String?
  totalAmount   Decimal             @db.Decimal(18, 2)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?
  updatedBy     String?
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  branch        Branch              @relation(fields: [branchId], references: [id])
  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  @@unique([poNumber, tenantId])
  @@index([supplierId])
  @@index([branchId])
  @@index([tenantId])
}

model PurchaseOrderItem {
  id          String        @id @default(cuid())
  tenantId    String        @default("default")
  poId        String
  itemId      String
  quantity    Int
  receivedQty Int           @default(0)
  unitPrice   Decimal       @db.Decimal(18, 2)
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  item        InventoryItem @relation(fields: [itemId], references: [id])

  @@index([poId])
  @@index([itemId])
}

model GoodsReceipt {
  id          String             @id @default(cuid())
  tenantId    String             @default("default")
  grNumber    String
  poId        String
  branchId    String
  receiptDate DateTime           @default(now())
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  updatedBy   String?
  po          PurchaseOrder      @relation(fields: [poId], references: [id])
  branch      Branch             @relation(fields: [branchId], references: [id])
  items       GoodsReceiptItem[]

  @@unique([grNumber, tenantId])
  @@index([poId])
  @@index([branchId])
  @@index([tenantId])
}

model GoodsReceiptItem {
  id        String        @id @default(cuid())
  tenantId  String        @default("default")
  grId      String
  itemId    String
  quantity  Int
  unitPrice Decimal       @db.Decimal(18, 2)
  gr        GoodsReceipt  @relation(fields: [grId], references: [id], onDelete: Cascade)
  item      InventoryItem @relation(fields: [itemId], references: [id])

  @@index([grId])
  @@index([itemId])
}

model StockOut {
  id        String         @id @default(cuid())
  tenantId  String         @default("default")
  soNumber  String
  branchId  String
  type      StockOutType
  date      DateTime       @default(now())
  reason    String
  notes     String?
  createdBy String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  branch    Branch         @relation(fields: [branchId], references: [id])
  items     StockOutItem[]

  @@index([branchId])
  @@index([tenantId])
}

model StockOutItem {
  id       String        @id @default(cuid())
  tenantId String        @default("default")
  soId     String
  itemId   String
  quantity Int
  stockOut StockOut      @relation(fields: [soId], references: [id], onDelete: Cascade)
  item     InventoryItem @relation(fields: [itemId], references: [id])

  @@index([soId])
  @@index([itemId])
}

model SupplierReturn {
  id         String               @id @default(cuid())
  tenantId   String               @default("default")
  srNumber   String
  supplierId String
  branchId   String
  grId       String?
  status     SupplierReturnStatus @default(Draft)
  returnDate DateTime             @default(now())
  notes      String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  updatedBy  String?
  supplier   Supplier             @relation(fields: [supplierId], references: [id])
  branch     Branch               @relation(fields: [branchId], references: [id])
  items      SupplierReturnItem[]

  @@index([supplierId])
  @@index([branchId])
  @@index([tenantId])
}

model SupplierReturnItem {
  id       String               @id @default(cuid())
  tenantId String               @default("default")
  srId     String
  itemId   String
  quantity Int
  reason   SupplierReturnReason
  sr       SupplierReturn       @relation(fields: [srId], references: [id], onDelete: Cascade)
  item     InventoryItem        @relation(fields: [itemId], references: [id])

  @@index([srId])
  @@index([itemId])
}

model StockAudit {
  id          String           @id @default(cuid())
  tenantId    String           @default("default")
  auditNumber String
  branchId    String
  status      StockAuditStatus @default(Open)
  auditDate   DateTime         @default(now())
  completedAt DateTime?
  completedBy String?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  branch      Branch           @relation(fields: [branchId], references: [id])
  items       StockAuditItem[]

  @@index([branchId])
  @@index([tenantId])
}

model StockAuditItem {
  id          String        @id @default(cuid())
  tenantId    String        @default("default")
  auditId     String
  itemId      String
  systemQty   Int
  physicalQty Int?
  discrepancy Int?
  audit       StockAudit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  item        InventoryItem @relation(fields: [itemId], references: [id])

  @@index([auditId])
  @@index([itemId])
}
